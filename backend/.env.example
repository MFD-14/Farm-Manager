# Woodlands Farm Manager backend configuration
DATABASE_URL=postgres://wfm:wfm@127.0.0.1:5432/wfm
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=change-me
PORT=4000
FARM_TZ=Africa/Harare
MEDIA_DIR=./media
# Tank usable volume in litres, entered after Phase 0 rehabilitation (spec T1)
TANK_USABLE=80000
POOL_VOLUME=45000
BOREHOLE_LPH=6000
# Anthropic key for the VIM Claude Vision adapter; heuristic fallback used when absent
ANTHROPIC_API_KEY=
VIM_MODE=heuristic
# WhatsApp Business Cloud API (optional; sender no-ops when absent)
WA_TOKEN=
WA_PHONE_ID=
WA_VERIFY_TOKEN=change-me-verify
