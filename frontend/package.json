{
  "name": "wfm-frontend",
  "version": "1.2.0",
  "description": "Woodlands Farm Manager PWA: offline-first day view, capture flows, owner console",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "vite build && cap sync",
    "android:apk": "vite build && cap sync android && cd android && ./gradlew assembleDebug",
    "ios:open": "vite build && cap sync ios && cap open ios",
    "icons": "capacitor-assets generate --android --ios --iconBackgroundColor \"#1a5c2e\" --splashBackgroundColor \"#1a1209\""
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "idb": "^8.0.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5"
  },
  "license": "UNLICENSED",
  "author": "Musara Holdings LLC"
}
